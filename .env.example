APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=real_estate
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Offline license / kill switch — see App\Services\LicenseService and
# LICENSE-KILL-SWITCH.md. Signed token from `php artisan license:issue`;
# it carries its own expiry + grace. Empty on a client install => locked.
LICENSE_KEY=
# PROVIDER ONLY — absolute path to the secret signing key, read by
# license:keygen / license:issue. Set this OUTSIDE the project so it can't
# be zipped into a handover. Default: storage/license/private.pem
LICENSE_PRIVATE_KEY_PATH=
# DEV ONLY — used only when LICENSE_KEY is empty AND APP_ENV=local:
# ACTIVE | GRACE | EXPIRED | SUSPENDED | REVOKED
LICENSE_SIMULATED_STATUS=ACTIVE
LICENSE_SIMULATED_EXPIRY_DATE=

# In-App AI Assistant — get a key from https://console.anthropic.com (API
# Keys page). Without it the assistant replies "not configured yet" instead
# of a real answer — see App\Services\AiAssistantService.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
